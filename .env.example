# Copy to .env.local (npm) or .env (Docker Compose). Never commit secrets.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GMI_API_KEY=
GMI_MODEL=meta-llama/Llama-3.3-70B-Instruct
GMI_BASE_URL=https://api.gmi-serving.com/v1
GOOGLE_CLOUD_PROJECT=
FIRESTORE_DATABASE_ID=(default)
# Generate: openssl rand -hex 32
SESSION_SECRET=
# Optional shared access code, required if making Cloud Run public.
APP_ACCESS_TOKEN=
# Set to your actual HTTPS URL when hosting behind a proxy.
# APP_ORIGIN=https://breadberry.example.com
DAILY_GENERATION_LIMIT=200
SESSION_DAILY_LIMIT=20
# Local Firestore emulator only:
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8081
