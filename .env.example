# Copy to .env.local (npm) or .env (Docker Compose). Never commit secrets.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GMI_API_KEY=
GMI_MODEL=meta-llama/Llama-3.3-70B-Instruct
GMI_BASE_URL=https://api.gmi-serving.com/v1
GOOGLE_CLOUD_PROJECT=
FIRESTORE_DATABASE_ID=(default)
# Generate: openssl rand -hex 32
SESSION_SECRET=
# Sessions start automatically in local and cloud environments.
# Set to your actual HTTPS URL when hosting behind a proxy.
# APP_ORIGIN=https://breadberry.example.com
DAILY_GENERATION_LIMIT=200
SESSION_DAILY_LIMIT=20
# Local Firestore emulator only:
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8081


# DigiKey Product Information V4: server-side OAuth client credentials.
DIGIKEY_CLIENT_ID=
DIGIKEY_CLIENT_SECRET=
DIGIKEY_SANDBOX=false
# Search quotas are independent of AI generation quotas (Firestore required).
DIGIKEY_DAILY_LIMIT=800
DIGIKEY_SESSION_DAILY_LIMIT=100
